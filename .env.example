# SMASS 环境变量模板
# 用法：复制为 .env 后按本地情况填写。.env 已被 .gitignore 排除，不会进入版本库。
# 严禁把真实的 .env 提交到仓库或粘贴进报告/日志。

# ---- 基础 ----
# 生产必须为 False
DJANGO_DEBUG=True
# 生产必须设置一个足够随机的值，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=please-generate-a-random-secret-key
# 逗号分隔
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# 反向代理/HTTPS 场景再配置
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_BEHIND_PROXY=False

# ---- 数据库（MySQL） ----
DB_NAME=smass
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
DB_TEST_NAME=test_smass

# ---- 会话与日志 ----
DJANGO_SESSION_COOKIE_AGE=86400
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_DIR=logs

# ---- S17 会话安全（默认关闭，避免影响既有部署） ----
# 开启后连续 N 分钟无操作即自动退出登录
DJANGO_SESSION_IDLE_ENABLED=False
DJANGO_SESSION_IDLE_MINUTES=30
